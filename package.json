{
  "name": "shader-tab",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm locales && wxt -b chrome",
    "build": "pnpm locales && wxt build -b chrome",
    "zip": "pnpm locales && wxt zip -b chrome",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/check-build.mjs",
    "postinstall": "wxt prepare",
    "locales": "node scripts/generate-locales.mjs",
    "site:build": "pnpm build && node website/build.mjs",
    "site:preview": "vite preview --outDir .output/site --host 127.0.0.1 --port 4321",
    "site:deploy": "pnpm site:build && npx --yes wrangler@4.135.0 deploy --config website/wrangler.jsonc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hugeicons/core-free-icons": "4.3.4",
    "@hugeicons/react": "1.1.10",
    "@paper-design/shaders": "0.0.81",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@react-three/fiber": "^9.7.0",
    "@shadergradient/react": "2.4.20",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wxt": "^0.21.4"
  }
}
